# AI ofis sozlamalari. Nusxa oling: cp office/office.env.example office.env  (server/ papkasida), keyin to'ldiring.
# Telegram'da @BotFather -> /newbot bilan ofis uchun alohida bot oching va tokenini shu yerga yozing.
OFFICE_BOT_TOKEN=
# Botga /start yozing, u chat ID'ingizni aytadi. Shu yerga yozing: faqat siz ofisni boshqarasiz.
OWNER_CHAT_ID=
# Tekin AI kalitlari: kamida bittasi kerak, uchtasi bo'lsa majlisda 3 xil model gapiradi.
# Gemini: https://aistudio.google.com/apikey   Groq: https://console.groq.com/keys   OpenRouter: https://openrouter.ai/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Har provayderga kunlik so'rov chegarasi va kunlik xabar qoralamalari soni.
LLM_DAILY_LIMIT=150
OFFICE_DRAFTS_PER_DAY=20
# GitHub: ofis loyihalar reposini o'qiydi va /claude vazifalarini Issue qilib ochadi. Fine-grained token: kerakli repolar,
# ruxsatlar Contents: Read, Pull requests: Read, Issues: Read and write. https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
